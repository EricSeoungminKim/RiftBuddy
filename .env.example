ANTHROPIC_API_KEY=your_key_here
LLM_PROVIDER=mock
RIFTBUDDY_RESPONSE_LANGUAGE=ko
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
RIOT_API_KEY=your_riot_api_key
RIFTBUDDY_TEST_MODE=1
# RIFTBUDDY_TEST_MODE=0 <-- actual LLM mode
RIFTBUDDY_BYPASS_AUTH=1  # dev only — remove for production
VITE_RIFTBUDDY_WS_URL=ws://127.0.0.1:8001/ws
VITE_RIFTBUDDY_API_URL=http://127.0.0.1:8001
VITE_RIFTBUDDY_WS_TOKEN=your_supabase_jwt
VITE_RIFTBUDDY_RESPONSE_LANGUAGE=ko

# YOUR RIOT INFO
RIOT_GAME_NAME=NAME #EX) smk1234
RIOT_TAG_LINE= #EX) 1234, 5678, etc
RIOT_REGION= #EX) KR, NA, EUW, EUNE, JP, BR, LAN, LAS, OCE, TR, RU, PBE
RIOT_BENCHMARK_TIER=DIAMOND
RIOT_BENCHMARK_SAMPLES=25
RIOT_BENCHMARK_MATCHES_PER_PLAYER=3
RIOT_BENCHMARK_TTL_SECONDS=604800
